# Used only by docker compose. Copy to .env (gitignored): cp .env.example .env

# PostgreSQL. Local development database only; the same values are in SharboAPI/appsettings.Development.json,
# so change both if you change them here.
POSTGRES_USER=sharbo_user
POSTGRES_PASSWORD=sharbo_dev
POSTGRES_DB=sharbodb
# Host port for the database (5434 avoids clashing with a locally installed PostgreSQL on 5432).
POSTGRES_PORT=5434

# Firebase service account JSON as ONE line, wrapped in single quotes.
# Keep the "\n" escapes in private_key as they are.
# FIREBASE_CREDENTIALS='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n", ...}'
FIREBASE_CREDENTIALS=
# Firebase project id, e.g. sharbo-dev for development (optional for now, required once tokens are verified)
FIREBASE_PROJECT_ID=
